# SentinelAI Backend Configurations

# Security settings
SECRET_KEY=SUPER_SECRET_SECURITY_PHRASE_SENTINEL_AI_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use SQLite locally: sqlite:///./database/sentinel.db
# Future ready: postgresql://user:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./database/sentinel.db

# AI Provider Configuration
# Supported providers: gemini, openai, ollama
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# API Credentials
# Replace with actual API keys for active live AI analysis
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Ollama endpoint (if AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Notification Settings
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=soc-alert@sentinelai.local
