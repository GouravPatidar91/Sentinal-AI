# SentinelAI Platform Configuration

# Security Secret Key (Used for signing JWT authentication tokens)
SECRET_KEY=YOUR_SUPER_SECRET_STRING_CHANGE_IN_PRODUCTION

# SQLite Database Location
DATABASE_URL=sqlite:///./database/sentinel.db

# AI Provider Configurations
# Supported options: openrouter, gemini, openai, ollama
AI_PROVIDER=openrouter

# OpenRouter API Key (Supports free high-performance LLMs)
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Gemini API Key (If AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (If AI_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama Host URL (If AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
